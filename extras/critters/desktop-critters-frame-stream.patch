index 0000000..fb069b9
--- /dev/null
+++ b/crates/critter-core/src/stream.rs
@@ -0,0 +1,63 @@
+//! The frame stream: what `critterd --stream` writes for renderers outside this workspace (the
+//! Caelestia shell draws its critters with Quickshell). One JSON object per line over a Unix
+//! socket ([`crate::control::default_frames_socket_path`]), a new client first gets the latest
+//! frame. Fields are only ever added, so a client ignores the ones it does not know.
+//!
+//! ```json
+//! {"t":12.34,"frame":{"outputs":[...],"critters":[{"species":"cat","body":{...},"pose":{...},...}],"decals":[]}}
+//! ```
+//!
+//! `t` is seconds on the daemon's clock, for interpolating between frames. A parked critter is
+//! missing from `critters`.
+
+use crate::frame::Frame;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Serialize)]
+struct Line<'a> {
+    t: f64,
+    frame: &'a Frame,
+}
+
+/// One line of the stream, with its newline.
+pub fn line(t: f64, frame: &Frame) -> String {
+    let mut line = serde_json::to_string(&Line { t, frame }).expect("a frame is always serialisable");
+    line.push('\n');
+    line
+}
+
+/// A line read back, for clients written in Rust and for tests.
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct StreamFrame {
+    pub t: f64,
+    pub frame: Frame,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::frame::{CritterSprite, Pose, PoseKind};
+    use crate::geometry::Rect;
+    use crate::world::Layer;
+
+    #[test]
+    fn a_frame_survives_the_wire() {
+        let frame = Frame {
+            critters: vec![CritterSprite {
+                species: "cat".into(),
+                body: Rect { x: 100.0, y: 200.0, w: 44.0, h: 30.0 },
+                layer: Layer(2),
+                occluders: vec![Rect { x: 0.0, y: 0.0, w: 50.0, h: 50.0 }],
+                pose: Pose { kind: PoseKind::Run, facing: -1.0, phase: 0.25, ..Pose::default() },
+                variant: 0,
+                soot: 0.0,
+            }],
+            ..Frame::default()
+        };
+        let text = line(3.5, &frame);
+        assert!(text.ends_with('\n') && text.matches('\n').count() == 1, "one line per frame");
+        assert!(text.contains(r#""kind":"run""#), "poses are snake_case words: {text}");
+        let back: StreamFrame = serde_json::from_str(&text).unwrap();
+        assert_eq!(back, StreamFrame { t: 3.5, frame });
+    }
+}
