+//! `--stream`: the frames for renderers outside this process, such as the Caelestia shell.
+//!
+//! Everybody who connects to the socket gets the latest frame of the [`FrameSlot`] as one JSON line
+//! (see [`critter_core::stream`]) about `hz` times a second. Nobody connected, nothing is
+//! serialised. A client that stops reading, or goes away, is dropped.
+
+use critter_core::frame::FrameSlot;
+use critter_core::stream::line;
+use std::io::Write;
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::Path;
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant};
+
+type Clients = Arc<Mutex<Vec<UnixStream>>>;
+
+/// How long a client may take to accept a line before it is let go.
+const WRITE_TIMEOUT: Duration = Duration::from_millis(100);
+
+/// Start serving `slot` on `path` at about `hz` frames per second.
+pub fn spawn(path: &Path, slot: Arc<FrameSlot>, hz: f32) -> anyhow::Result<()> {
+    if path.exists() {
+        // Like the control socket: only a socket nobody answers on is a leftover from a crashed run.
+        if UnixStream::connect(path).is_ok() {
+            anyhow::bail!("another critterd is already streaming on {} (use --stream PATH for a second one)", path.display());
+        }
+        std::fs::remove_file(path)?;
+    }
+    let listener = UnixListener::bind(path)?;
+    let clients: Clients = Arc::default();
+    let t0 = Instant::now();
+
+    let (accept_clients, accept_slot) = (clients.clone(), slot.clone());
+    thread::Builder::new().name("stream-accept".into()).spawn(move || {
+        for mut client in listener.incoming().flatten() {
+            let _ = client.set_write_timeout(Some(WRITE_TIMEOUT));
+            // The newcomer need not wait for the next tick to see something.
+            if client.write_all(line(t0.elapsed().as_secs_f64(), &accept_slot.latest()).as_bytes()).is_ok() {
+                accept_clients.lock().unwrap_or_else(|e| e.into_inner()).push(client);
+            }
+        }
+    })?;
+
+    let every = Duration::from_secs_f32(1.0 / hz.max(1.0));
+    thread::Builder::new().name("stream-send".into()).spawn(move || {
+        while !slot.quit_requested() {
+            thread::sleep(every);
+            let mut clients = clients.lock().unwrap_or_else(|e| e.into_inner());
+            if clients.is_empty() {
+                continue;
+            }
+            let text = line(t0.elapsed().as_secs_f64(), &slot.latest());
+            clients.retain_mut(|c| c.write_all(text.as_bytes()).is_ok());
+        }
+    })?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use critter_core::frame::{CritterSprite, Frame, Pose};
+    use critter_core::stream::StreamFrame;
+    use std::io::{BufRead, BufReader};
+
+    fn sprite(x: f32) -> CritterSprite {
+        CritterSprite {
+            species: "cat".into(),
+            body: critter_core::geometry::Rect { x, y: 10.0, w: 44.0, h: 30.0 },
+            layer: critter_core::world::Layer(0),
+            occluders: Vec::new(),
+            pose: Pose::default(),
+            variant: 0,
+            soot: 0.0,
+        }
+    }
+
+    fn socket(name: &str) -> std::path::PathBuf {
+        std::env::temp_dir().join(format!("critterd-stream-test-{}-{name}.sock", std::process::id()))
+    }
+
+    /// A client gets the latest frame at once and then fresh ones, each on its own line.
+    #[test]
+    fn a_client_receives_frames_as_lines() {
+        let (path, slot) = (socket("lines"), Arc::new(FrameSlot::default()));
+        slot.publish(Frame { critters: vec![sprite(1.0)], ..Frame::default() });
+        spawn(&path, slot.clone(), 100.0).unwrap();
+
+        let client = UnixStream::connect(&path).unwrap();
+        client.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+        let mut lines = BufReader::new(client).lines();
+        let first: StreamFrame = serde_json::from_str(&lines.next().unwrap().unwrap()).unwrap();
+        assert_eq!(first.frame.critters[0].body.x, 1.0);
+
+        slot.publish(Frame { critters: vec![sprite(2.0)], ..Frame::default() });
+        let mut seen = None;
+        for _ in 0..50 {
+            let next: StreamFrame = serde_json::from_str(&lines.next().unwrap().unwrap()).unwrap();
+            if next.frame.critters[0].body.x == 2.0 {
+                assert!(next.t >= first.t, "the clock only goes forward");
+                seen = Some(next);
+                break;
+            }
+        }
+        assert!(seen.is_some(), "the new frame arrives within a few ticks");
+        slot.request_quit();
+        let _ = std::fs::remove_file(path);
+    }
+
+    /// A second daemon refuses to take the socket of a running one, and a stale file is replaced.
+    #[test]
+    fn only_a_stale_socket_is_taken_over() {
+        let (path, slot) = (socket("claim"), Arc::new(FrameSlot::default()));
+        spawn(&path, slot.clone(), 30.0).unwrap();
+        let err = spawn(&path, slot.clone(), 30.0).unwrap_err().to_string();
+        assert!(err.contains("already streaming"), "{err}");
+        slot.request_quit();
+
+        // A socket file with nobody behind it is a leftover.
+        let stale = socket("stale");
+        drop(UnixListener::bind(&stale).unwrap());
+        assert!(stale.exists());
+        spawn(&stale, Arc::new(FrameSlot::default()), 30.0).unwrap();
+        let _ = std::fs::remove_file(path);
+        let _ = std::fs::remove_file(stale);
+    }
